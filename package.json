{
  "name": "mv-vault",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Two simple flows: new Tamil releases (year folder + latest series) and a resumable A-Z archive",
  "scripts": {
    "releases": "node src/run.mjs --mode=releases",
    "az": "node src/run.mjs --mode=az",
    "dry": "node src/run.mjs --mode=releases --dry --max-items=3",
    "enrich": "node src/run.mjs --mode=enrich"
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}

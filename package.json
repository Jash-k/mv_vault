{
  "name": "moviesda-vault",
  "version": "2.2.0",
  "type": "module",
  "description": "Durable onestream-embed vault for moviesda \u2014 new-arrival detection, failure-aware retries, re-listed-page aliases and a nightly embed-liveness sweep",
  "scripts": {
    "test": "node --test",
    "verify": "node src/verify.js",
    "check": "node src/verify.js",
    "manifest": "node scripts/make-manifest.mjs",
    "scrape": "node src/cli.js",
    "incremental": "node src/cli.js --incremental",
    "sweep": "node src/cli.js --sweep",
    "ingest": "node src/ingest.js",
    "enrich": "node src/enrich.js",
    "repair": "node src/repair.js",
    "liveness": "node src/cli.js --refresh=600"
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
